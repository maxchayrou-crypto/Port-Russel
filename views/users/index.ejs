
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des utilisateurs - Port-Russel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("../partials/header") %>

    <main class="container">
        <h1 class="page-title">Gestion des utilisateurs</h1>

        <section class="card">
            <h2>Ajouter un utilisateur</h2>

            <form action="/users/create" method="POST">
                <div class="form-group">
                    <label for="username">Nom d'utilisateur</label>
                    <input type="text" id="username" name="username" required minlength="3">
                </div>

                <div class="form-group">
                    <label for="email">Adresse email</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" required minlength="8">
                </div>

                <button type="submit" class="btn">
                    Ajouter l'utilisateur
                </button>
            </form>
        </section>

        <section class="card">
            <h2>Liste des utilisateurs</h2>

            <% if (users.length === 0) { %>
                <p>Aucun utilisateur enregistré.</p>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Nom d'utilisateur</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td><%= user.username %></td>
                                <td><%= user.email %></td>
                                <td>
                                    <a href="/users/<%= encodeURIComponent(user.email) %>/edit" class="btn">
    Modifier
</a>
                                    <form action="/users/<%= encodeURIComponent(user.email) %>/delete"
                                          method="POST"
                                          onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                        <button type="submit" class="btn">
                                            Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </section>
    </main>

    <footer>
        <p>© Port-Russel - Gestion du port de plaisance</p>
    </footer>

</body>
</html>
