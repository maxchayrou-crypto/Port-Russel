
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier un utilisateur - Port-Russel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("../partials/header") %>

    <main class="container">
        <h1 class="page-title">Modifier un utilisateur</h1>

        <section class="card">
            <form action="/users/<%= encodeURIComponent(user.email) %>/update" method="POST">

                <div class="form-group">
                    <label for="username">Nom d'utilisateur</label>
                    <input
                        type="text"
                        id="username"
                        name="username"
                        value="<%= user.username %>"
                        required
                        minlength="3"
                    >
                </div>

                <div class="form-group">
                    <label for="email">Adresse email</label>
                    <input
                        type="email"
                        id="email"
                        value="<%= user.email %>"
                        disabled
                    >
                    <small>L'adresse email ne peut pas être modifiée.</small>
                </div>

                <div class="form-group">
                    <label for="password">Nouveau mot de passe (facultatif)</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        minlength="8"
                        placeholder="Laisser vide pour conserver le mot de passe actuel"
                    >
                </div>

                <button type="submit" class="btn">
                    Enregistrer les modifications
                </button>

                <a href="/users" class="btn">Annuler</a>
            </form>
        </section>
    </main>

    <footer>
        <p>© Port-Russel - Gestion du port de plaisance</p>
    </footer>

</body>
</html>
